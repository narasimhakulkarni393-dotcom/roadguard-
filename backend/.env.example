# PitScout / RoadGuard AI environment template
# Copy to backend/.env and fill in real values. Never commit the filled file.

# Machine-to-machine API key. Required. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ROADGUARD_API_KEY=

DATABASE_URL=sqlite:///./roadguard.db
ENVIRONMENT=development
DEBUG=False

# Explicit browser origins allowed by CORS (comma separated, no wildcards).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# In-process fixed-window rate limiting.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Detection provider: "yolo" (local weights) or "hf-inference" (remote API).
# hf-inference does not need torch/ultralytics locally but requires HF_TOKEN.
DETECTION_PROVIDER=yolo

# Hugging Face Inference API (only used when DETECTION_PROVIDER=hf-inference).
# Generate a token at https://huggingface.co/settings/tokens. Never commit it.
HF_TOKEN=
# facebook/detr-resnet-50 is COCO-trained and has no road-damage classes; use a
# road-damage object-detection model id for meaningful pothole/crack output.
HF_DETECTION_MODEL_ID=facebook/detr-resnet-50

# Image pipeline thresholds
DETECTION_CONFIDENCE_THRESHOLD=0.15
DETECTION_IOU_THRESHOLD=0.45
ROAD_CONFIDENCE_THRESHOLD=0.50

# Video pipeline
VIDEO_SAMPLE_FPS=2.0
VIDEO_MAX_SAMPLED_FRAMES=300
TRACK_IOU_THRESHOLD=0.30
TRACK_MAX_AGE_FRAMES=4
TRACK_MIN_HITS=2

# Geolocation and duplicate matching
LOCATION_MAX_ACCURACY_M=100
MATCH_BASE_RADIUS_M=50
MATCH_THRESHOLD=0.72
MATCH_REVIEW_THRESHOLD=0.55
