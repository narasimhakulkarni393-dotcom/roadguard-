# RoadGuard AI Environment Variables
ROADGUARD_API_KEY=your_secure_api_key_here
DATABASE_URL=sqlite:///./roadguard.db
ENVIRONMENT=production
DEBUG=False

# Server Host & Port
HOST=0.0.0.0
PORT=8000
WORKERS=1

# Security & Cryptography
SECRET_KEY=roadguard-production-secure-key-32-bytes-token
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000,https://frontend-nine-flame-89.vercel.app"

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
