# PitScout / RoadGuard AI environment template
# The backend loads backend/.env. Copy backend/.env.example there and fill it in.
# Never commit a filled .env or real credentials.

ROADGUARD_API_KEY=
DATABASE_URL=sqlite:///./roadguard.db
ENVIRONMENT=development
DEBUG=False
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
