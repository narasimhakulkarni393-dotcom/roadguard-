# PitScout frontend server environment.
# These variables are read by Next.js route handlers only. Do NOT prefix them
# with NEXT_PUBLIC_: the API key must never reach the browser bundle.

# Base URL of the FastAPI backend (no trailing slash).
# This workspace verified on 8001 because an older service occupies 8000.
BACKEND_URL=http://127.0.0.1:8001

# Same value as ROADGUARD_API_KEY in backend/.env. Leave empty to fail closed (503).
ROADGUARD_API_KEY=
